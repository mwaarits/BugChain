# Frontend env — copy to frontend/.env or set in the Vercel project.
# Chain config swap only: testnet (968) -> mainnet (677) = change these three values.

VITE_CHAIN_ID=968
VITE_RPC_URL=https://rpc.bohr.life
VITE_CONTRACT_ADDRESS=0x
VITE_API_URL=http://localhost:3000

# Mainnet values after the human deployment gate:
# VITE_CHAIN_ID=677
# VITE_RPC_URL=https://rpc.botchain.ai
# VITE_CONTRACT_ADDRESS=<verified mainnet contract address>
# VITE_API_URL=<production backend HTTPS URL>
