# Backend env — copy to backend/.env or export in the deploy environment.
# See runbooks/testnet-deploy.md for the walkthrough.

RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
ADMIN_PRIVATE_KEY=0x
# Bearer token that guards POST /api/admin/* (dispute actions). Keep secret.
ADMIN_TOKEN=
# Optional Postgres URL. Empty -> in-memory PGlite (dev/tests only).
DATABASE_URL=
PORT=3000