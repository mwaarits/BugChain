# Backend env — copy to backend/.env or export in the deploy environment.
# See runbooks/testnet-deploy.md and runbooks/mainnet-gate.md.

RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
# Production: inject from a secret manager; never store the mainnet key in a file.
ADMIN_PRIVATE_KEY=0x
# Operator auth: browser wallet address allowed to operate /api/admin/* via a
# signed challenge (preferred over ADMIN_TOKEN). Keep secret.
ADMIN_OPERATOR=
# Legacy bearer token guarding POST /api/admin/*. Falls back to this when
# ADMIN_OPERATOR is unset. Keep secret.
ADMIN_TOKEN=
# Optional Postgres URL. Empty -> in-memory PGlite (dev/tests only).
DATABASE_URL=
PORT=3000
