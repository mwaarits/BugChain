{
  "name": "backend",
  "private": true,
  "version": "1.0.0",
  "description": "BOT bounty platform backend — Hono API, snapshot indexer, Postgres",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prebuild": "npm run build --workspace @gmtbuilder/shared",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build --workspace @gmtbuilder/shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "npm run build --workspace @gmtbuilder/shared",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.15",
    "@gmtbuilder/shared": "1.0.0",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.3",
    "postgres": "^3.4.5",
    "viem": "^2.21.39"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}